{
  "name": "ta-mortgages-desktop",
  "productName": "T.A Mortgages",
  "version": "1.1.1",
  "private": true,
  "description": "T.A Mortgages — financial management for the advisor (Windows desktop)",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "node build.mjs",
    "test:core": "node build.mjs && node --test dist/core.test.js",
    "stage:win": "node build.mjs && node assemble.mjs --platform win32",
    "stage:linux": "node build.mjs && node assemble.mjs --platform linux",
    "dist:win": "npm run stage:win && electron-builder --win --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pg": "8.15.5",
    "@types/pg-copy-streams": "1.2.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.11",
    "embedded-postgres": "16.15.0-beta.19",
    "jszip": "3.10.2",
    "pg": "8.16.3",
    "pg-copy-streams": "7.0.0"
  },
  "author": "T.A Mortgages"
}
