# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://ta:CHANGE_ME@localhost:5432/ta_platform?schema=public"

# Field-level encryption key ring: id:base64(32 bytes), comma-separated; LAST one encrypts.
# Generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=""
# HMAC key for blind indexes (base64, 32 bytes). Generate like above without the "v1:" prefix.
BLIND_INDEX_KEY=""

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
APP_URL="http://localhost:3000"   # production: https://<DOMAIN>
TOTP_ISSUER="T.A Mortgages"
UPLOAD_DIR="./storage/uploads"

# Seed (optional). If passwords are empty, random ones are generated and printed once.
SEED_ADVISOR_EMAIL="advisor@example.test"
SEED_ADVISOR_PASSWORD=""
SEED_DEMO_CLIENT_PASSWORD=""
SEED_DEMO_DATA="true"
POSTGRES_PASSWORD=""

# Production (docker compose): public hostname and Let's Encrypt contact for Caddy.
DOMAIN=""
ACME_EMAIL=""
# Production seeding: reference data + advisor only. NEVER "true" in production.
# SEED_DEMO_DATA="false"
# PDF rendering: set by the Docker image (/usr/bin/chromium); locally Playwright's Chromium is used.
# CHROMIUM_PATH=""
