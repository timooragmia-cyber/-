# Copy to backup.env (never commit). Used ONLY by the backup container — the app never sees these.

# age PUBLIC key (starts with age1…). The private key stays off the server (password manager / safe).
AGE_RECIPIENT=""

# S3-compatible storage. AWS (Israel region: il-central-1), Backblaze B2, Wasabi, …
S3_BUCKET=""
S3_PREFIX="ta-platform"
# Leave empty for AWS; e.g. https://s3.eu-central-003.backblazeb2.com for Backblaze.
S3_ENDPOINT=""
AWS_DEFAULT_REGION="il-central-1"
# A key that can ONLY write/list this bucket (no delete — see docs/DEPLOYMENT.md §Backups).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
